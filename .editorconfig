root = true

[*]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cpp,cxx,cc,h,hpp,hxx}]
cpp_new_line_before_open_brace_in_namespace = false
cpp_new_line_before_open_brace_in_type = false
cpp_new_line_before_open_brace_in_function = false
cpp_new_line_before_open_brace_in_control_block = false
cpp_new_line_before_open_brace_in_lambda = false
cpp_new_line_before_open_brace_in_method = false

cpp_space_after_keyword_in_control_flow_statement = true
cpp_space_around_binary_operator = true
cpp_space_around_assignment_operator = true
cpp_space_before_opening_brace_in_control_flow_statement = true
cpp_space_after_comma = true
cpp_space_before_comma = false
